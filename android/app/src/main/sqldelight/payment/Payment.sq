import java.time.Instant;

CREATE TABLE PaymentEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    userId INTEGER NOT NULL,
    amount INTEGER NOT NULL,
    createdAt INTEGER AS Instant NOT NULL,
    status TEXT NOT NULL, -- Completed, Canceled
    direction TEXT NOT NULL, --Credit, Debit
    FOREIGN KEY (userId) REFERENCES UserEntity(id)
);

CREATE TABLE InvoiceEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    paymentId INTEGER NOT NULL,
    totalPaid INTEGER NOT NULL,
    totalOwed INTEGER NOT NULL,
    FOREIGN KEY (paymentId) REFERENCES PaymentEntity(id)
);

CREATE TABLE InvoiceItemEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    invoiceId INTEGER NOT NULL,
    orderId INTEGER NOT NULL,
    amountPaid INTEGER NOT NULL,
    amountOwed INTEGER NOT NULL,
    FOREIGN KEY (invoiceId) REFERENCES InvoiceEntity(id),
    FOREIGN KEY (orderId) REFERENCES OrderEntity(id)
);

CREATE VIEW InvoicePaymentView AS
SELECT InvoiceItemEntity.id AS invoiceItemId, invoiceId, orderId, amountPaid, amountOwed, userId,
paymentId, totalPaid, totalOwed, status, direction
FROM InvoiceItemEntity
JOIN InvoiceEntity ON InvoiceItemEntity.invoiceId = InvoiceEntity.id
JOIN PaymentEntity ON InvoiceEntity.paymentId = PaymentEntity.id;

insertPayment:
INSERT INTO PaymentEntity(userId, amount, createdAt, status, direction)
VALUES (?, ?, ?, ?, ?);

insertInvoice:
INSERT INTO InvoiceEntity(paymentId, totalOwed, totalPaid)
VALUES (?, ?, ?);

insertInvoiceItem:
INSERT INTO InvoiceItemEntity(invoiceId, orderId, amountPaid, amountOwed)
VALUES (?, ?, ?, ?);

userPayments:
SELECT id, amount, createdAt, status, direction
FROM PaymentEntity
WHERE userId = :userId
ORDER BY createdAt DESC;

unpaidOrderEntity:
SELECT
    OrderEntity.id AS orderId, OrderEntity.createdAt, RestaurantEntity.name,
    CASE
        WHEN OrderEntity.payerId = :userId THEN total(OrderItemView.total) ELSE 0
    END AS totalPaid,
    total(
        CASE
            WHEN OrderItemView.userId = :userId THEN OrderItemView.total ELSE 0
        END
    ) AS totalOwed
FROM OrderEntity
JOIN RestaurantEntity ON RestaurantEntity.id = OrderEntity.restaurantId
JOIN OrderItemView ON OrderItemView.orderId = OrderEntity.id
WHERE (OrderEntity.payerId = :userId OR OrderItemView.userId = :userId)
  AND NOT EXISTS (
      SELECT 1
      FROM InvoicePaymentView
      WHERE InvoicePaymentView.orderId = OrderEntity.id
        AND InvoicePaymentView.status = 'Completed'
  )
GROUP BY OrderEntity.id
ORDER BY OrderEntity.createdAt DESC;

lastInsertRowId:
SELECT last_insert_rowid();